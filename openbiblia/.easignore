# EAS build archive exclusions.
# EAS force-includes node_modules unless explicitly excluded here; when
# excluded, dependencies are installed on the build server from bun.lock.

node_modules
.expo
dist
.git
.vscode
bibles/*
commentaries/*

# Generated by prebuild on EAS servers
android
ios

# Credentials and local databases — never upload
*.db
*.jks
*.p8
*.p12
*.key